#!/bin/sh
# Initial configuration script for luci-app-istore-ups

[ -x /sbin/uci ] || exit 0

# Generate safe random password for local nut monitor user if unset or default
CURRENT_PASS=$(uci -q get istore_ups.nut_service.mon_password)
if [ -z "$CURRENT_PASS" ] || [ "$CURRENT_PASS" = "monpass" ]; then
    RAND_PASS=$(tr -dc 'a-zA-Z0-9' < /dev/urandom 2>/dev/null | head -c 16)
    [ -n "$RAND_PASS" ] || RAND_PASS="istore_$(date +%s)"
    uci -q set istore_ups.nut_service.mon_password="$RAND_PASS"
    uci -q set istore_ups.ups.remote_password="$RAND_PASS"
fi

CURRENT_ADMIN=$(uci -q get istore_ups.nut_service.admin_password)
if [ -z "$CURRENT_ADMIN" ] || [ "$CURRENT_ADMIN" = "adminpass" ]; then
    RAND_ADMIN=$(tr -dc 'a-zA-Z0-9' < /dev/urandom 2>/dev/null | head -c 16)
    [ -n "$RAND_ADMIN" ] || RAND_ADMIN="admin_$(date +%s)"
    uci -q set istore_ups.nut_service.admin_password="$RAND_ADMIN"
fi

uci commit istore_ups

# Create runtime directories in tmpfs
mkdir -p /tmp/run/istore-ups /tmp/log/istore-ups 2>/dev/null

exit 0
